{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "SViewer",
  "version": "../../../package.json",
  "identifier": "com.while.sviewer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8386",
    "beforeDevCommand": "pnpm --filter @sviewer/app exec vite dev --port 8386",
    "beforeBuildCommand": "pnpm --filter @sviewer/app exec vite build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "素阅 SViewer",
        "width": 1100,
        "height": 720,
        "minWidth": 500,
        "minHeight": 360,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "while",
    "macOS": {
      "bundleName": "素阅"
    },
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "app", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["jpg", "jpeg", "jpe", "jfif"],
        "name": "JPEG 图像",
        "description": "图片文件",
        "role": "Viewer",
        "contentTypes": ["public.jpeg"],
        "mimeType": "image/jpeg"
      },
      {
        "ext": ["png"],
        "name": "PNG 图像",
        "description": "图片文件",
        "role": "Viewer",
        "contentTypes": ["public.png"],
        "mimeType": "image/png"
      },
      {
        "ext": ["gif"],
        "name": "GIF 图像",
        "description": "图片文件",
        "role": "Viewer",
        "contentTypes": ["com.compuserve.gif"],
        "mimeType": "image/gif"
      },
      {
        "ext": ["webp"],
        "name": "WebP 图像",
        "description": "图片文件",
        "role": "Viewer",
        "contentTypes": ["org.webmproject.webp"],
        "mimeType": "image/webp"
      },
      {
        "ext": ["bmp"],
        "name": "BMP 图像",
        "description": "图片文件",
        "role": "Viewer",
        "contentTypes": ["com.microsoft.bmp"],
        "mimeType": "image/bmp"
      },
      {
        "ext": ["ico"],
        "name": "ICO 图像",
        "description": "图片文件",
        "role": "Viewer",
        "contentTypes": ["com.microsoft.ico"],
        "mimeType": "image/vnd.microsoft.icon"
      },
      {
        "ext": ["svg"],
        "name": "SVG 图像",
        "description": "图片文件",
        "role": "Viewer",
        "contentTypes": ["public.svg-image"],
        "mimeType": "image/svg+xml"
      },
      {
        "ext": ["tiff", "tif"],
        "name": "TIFF 图像",
        "description": "图片文件",
        "role": "Viewer",
        "contentTypes": ["public.tiff"],
        "mimeType": "image/tiff"
      },
      {
        "ext": ["avif"],
        "name": "AVIF 图像",
        "description": "图片文件",
        "role": "Viewer",
        "contentTypes": ["public.avif"],
        "mimeType": "image/avif"
      },
      {
        "ext": ["heic", "heif", "hif"],
        "name": "HEIF 图像",
        "description": "图片文件",
        "role": "Viewer",
        "contentTypes": ["public.heic", "public.heif"],
        "mimeType": "image/heic;image/heif"
      },
      {
        "ext": ["tga"],
        "name": "TGA 图像",
        "description": "图片文件",
        "role": "Viewer",
        "contentTypes": ["com.truevision.tga-image"],
        "mimeType": "image/x-tga"
      },
      {
        "ext": ["exr"],
        "name": "OpenEXR 图像",
        "description": "图片文件",
        "role": "Viewer",
        "contentTypes": ["com.ilm.openexr-image"],
        "mimeType": "image/x-exr"
      },
      {
        "ext": ["pbm", "pgm", "ppm", "pnm", "dds", "hdr", "qoi"],
        "name": "Image",
        "description": "图片文件",
        "role": "Viewer",
        "mimeType": "image/x-portable-anymap;image/vnd-ms.dds;image/vnd.radiance"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "./linux/sviewer.desktop"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhEN0M3NkIyM0MwRUFEQzYKUldUR3JRNDhzblo4alZ4dVRCUHJzekJPUUgwUG9SaVdJT2hDcytnQStBdkY2UkxhN1FhMUxvN1AK",
      "endpoints": [
        "https://github.com/while-coder/sviewer/releases/download/updater/latest.json"
      ]
    }
  }
}
