{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "SViewer",
  "version": "../../../package.json",
  "identifier": "com.while.sviewer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8386",
    "beforeDevCommand": "pnpm --filter @sviewer/app exec vite dev --port 8386",
    "beforeBuildCommand": "pnpm --filter @sviewer/app exec vite build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "素阅 SViewer",
        "width": 1100,
        "height": 720,
        "minWidth": 500,
        "minHeight": 360,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "while",
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "app", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "jpg", "jpeg", "jpe", "jfif", "png", "gif", "webp", "bmp", "ico", "svg", "avif",
          "tiff", "tif", "heic", "heif", "hif", "tga", "pbm", "pgm", "ppm", "pnm",
          "dds", "hdr", "exr", "qoi"
        ],
        "name": "Image",
        "description": "图片文件",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhEN0M3NkIyM0MwRUFEQzYKUldUR3JRNDhzblo4alZ4dVRCUHJzekJPUUgwUG9SaVdJT2hDcytnQStBdkY2UkxhN1FhMUxvN1AK",
      "endpoints": [
        "https://github.com/while-coder/sviewer/releases/download/updater/latest.json"
      ]
    }
  }
}
